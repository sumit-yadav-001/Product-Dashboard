# API Configuration
VITE_API_BASE_URL=http://localhost:5000/api
VITE_BACKEND_API_URL=http://localhost:5000/api

# External APIs (for other features)
VITE_DUMMYJSON_API=https://dummyjson.com
VITE_JSONPLACEHOLDER_API=https://jsonplaceholder.typicode.com
VITE_FAKESTORE_API=https://fakestoreapi.com

# App Configuration
VITE_APP_NAME=Admin Template
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_FEATURE_BETA_ENABLED=false
VITE_FEATURE_ANALYTICS_ENABLED=true
VITE_FEATURE_EXPERIMENTAL_UI=false

# External Services
VITE_SENTRY_DSN=
VITE_GOOGLE_ANALYTICS_ID=

# Development
VITE_DEV_MOCK_API=false
VITE_DEV_SHOW_REDUX_DEVTOOLS=true

# Authentication
VITE_AUTH_TOKEN_STORAGE_KEY=admin_template_token
VITE_AUTH_REFRESH_TOKEN_STORAGE_KEY=admin_template_refresh_token

# Theme
VITE_DEFAULT_THEME=light
VITE_DEFAULT_LANGUAGE=en

# Pagination
VITE_DEFAULT_PAGE_SIZE=20
VITE_MAX_PAGE_SIZE=100

# Cache
VITE_CACHE_TIME_SHORT=60
VITE_CACHE_TIME_MEDIUM=300
VITE_CACHE_TIME_LONG=600
